generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("student") // student, instructor, admin
  status        String    @default("active") // active, suspended

  accounts      Account[]
  sessions      Session[]
  enrollments      Enrollment[]
  contributions    Contribution[]
  lessonProgresses LessonProgress[]
  tasksAssigned    Task[] @relation("AssignedBy")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  cohorts     Cohort[]
  courses     Course[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cohort {
  id          String   @id @default(cuid())
  name        String
  programId   String
  startDate   DateTime
  weekCount   Int

  program     Program  @relation(fields: [programId], references: [id])
  teams       Team[]
  enrollments Enrollment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id          String   @id @default(cuid())
  name        String
  cohortId    String

  cohort      Cohort   @relation(fields: [cohortId], references: [id])
  enrollments Enrollment[]
  tasks       Task[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  cohortId    String
  teamId      String?

  user        User     @relation(fields: [userId], references: [id])
  cohort      Cohort   @relation(fields: [cohortId], references: [id])
  team        Team?    @relation(fields: [teamId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, cohortId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  status      String   @default("draft") // draft, in_review, published
  programId   String

  program     Program  @relation(fields: [programId], references: [id])
  lessons     Lesson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  contentType String   // video, PDF, markdown, audio, code
  contentUrl  String?
  textContent String?
  order       Int
  courseId    String

  course           Course   @relation(fields: [courseId], references: [id])
  tasks            Task[]
  lessonProgresses LessonProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id            String   @id @default(cuid())
  title         String
  state         String   @default("Assigned") // Assigned, Branched, Pushed, In Review, Closed
  teamId        String
  lessonId      String?
  assignedById  String?

  team          Team     @relation(fields: [teamId], references: [id])
  lesson        Lesson?  @relation(fields: [lessonId], references: [id])
  assignedBy    User?    @relation("AssignedBy", fields: [assignedById], references: [id])
  contributions Contribution[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contribution {
  id             String   @id @default(cuid())
  taskId         String
  userId         String
  commitCount    Int      @default(0)
  compositeScore Float    @default(0.0) // Calculated from files, surviving lines, reviews
  
  task           Task     @relation(fields: [taskId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  lastPosition Int      @default(0)
  isCompleted  Boolean  @default(false)
  
  user         User     @relation(fields: [userId], references: [id])
  lesson       Lesson   @relation(fields: [lessonId], references: [id])
  bookmarks    Bookmark[]
  notes        Note[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Bookmark {
  id               String         @id @default(cuid())
  lessonProgressId String
  position         Int
  label            String
  
  lessonProgress   LessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Note {
  id               String         @id @default(cuid())
  lessonProgressId String
  position         Int
  content          String
  
  lessonProgress   LessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}
